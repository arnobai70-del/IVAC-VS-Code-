{
  "app": {
    "name": "ivac-automation",
    "environment": "development"
  },
  "runtime": {
    "concurrency": 2,
    "jobsPerCycle": 2,
    "requestDelayMs": 250
  },
  "database": {
    "file": "data/ivac.sqlite3",
    "busyTimeoutMs": 5000
  },
  "network": {
    "proxyConfigFile": "config/proxies.json",
    "healthCheckUrl": null,
    "healthTimeoutMs": 5000,
    "cooldownMs": 30000
  },
  "portal": {
    "baseUrl": "https://mrboss.live",
    "pendingPath": "/api/application/pending",
    "healthPath": null,
    "timeoutMs": 10000,
    "maxResponseBytes": 1048576,
    "mapping": {
      "applicationId": "id",
      "userId": "user_id",
      "phone": "phone",
      "password": "password",
      "passportNumber": "passport_number",
      "documents": "documents"
    }
  },
  "otp": {
    "baseUrl": "https://otp.cat-paymentbd.com",
    "tablePath": "/otp_table",
    "pollIntervalMs": 3000,
    "timeoutMs": 120000,
    "maxResponseBytes": 2097152,
    "maxRows": 5000,
    "tableSelector": "table",
    "columns": {
      "phone": "Phone Number",
      "code": "OTP",
      "createdAt": "Created At"
    }
  },
  "target": {
    "baseUrl": "https://api.ivacbd.com/iams/api/v1",
    "timeoutMs": 15000
  },
  "logging": {
    "level": "info"
  }
}