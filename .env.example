# Copy this file to .env.local for local development.
# Never commit .env.local.

# Portal authentication.
PORTAL_API_ACCESS_TOKEN=

# Controlled activation profile.
#
# safe       = default; destructive Portal intake cannot be authorized.
# controlled = explicitly arms the controlled activation profile.
#
# Selecting "controlled" alone does NOT enable intake or workflow execution.
ACTIVATION_PROFILE=safe

# Optional overrides.
APP_ENV=development
LOG_LEVEL=info